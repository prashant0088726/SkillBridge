# ==============================================================================
# SkillBridge AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your secret credentials:
# Do not commit your real .env file with secrets to Git.

# --- Google Gemini AI API Key (REQUIRED for AI features) ---
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here

# Supported model: gemini-2.5-flash (default), gemini-1.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# --- JWT Security (Secret used for HMAC-SHA256 signing) ---
# Replace with a custom secret (at least 256 bits / 32 characters long) in production
JWT_SECRET=SkillBridgeAiSuperSecretKeyForDevelopmentOnlyAtLeast256BitsLong2026!
JWT_EXPIRATION_MS=604800000

# --- Database Selection ---
# Default profile uses file-based persistent H2 (no installation needed)
# Data survives server restarts in ./data/skillbridge_db
SPRING_PROFILES_ACTIVE=default

# To switch to MySQL (using local MySQL80 on port 3306):
# 1. Ensure MySQL service is running
# 2. Set: SPRING_PROFILES_ACTIVE=mysql
# 3. Configure credentials below:
MYSQL_USER=root
MYSQL_PASSWORD=root
